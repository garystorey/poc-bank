    "@angular/router": "^17.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^3.25.76",
    "zone.js": "~0.14.3"
  },
